{
    "profile": "django",
    "indent": 4,
    "max_line_length": 79,
    "max_attribute_length": 80,
    "format_attribute_template_tags": true,
    "format_css": true,
    "format_js": true,
    "preserve_blank_lines": true,
    "preserve_leading_space": true,
    "close_void_tags": false,
    "ignore": "H006,H023,H030,H031,T002,T003",
    "exclude": ".venv,node_modules,htmlcov,site,dist,build,bup,wip,tmp"
}
